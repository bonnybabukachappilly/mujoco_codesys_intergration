<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cr5">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import cr5 urdf file -->
    <xacro:include filename="$(find dobot_description)/urdf/cr5/cr5.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="cr5.ros2_control.xacro" />


    <xacro:cr5_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
