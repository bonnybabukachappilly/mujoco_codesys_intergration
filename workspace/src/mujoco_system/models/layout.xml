<mujoco model="station_layout">
    <!-- <compiler angle="radian" eulerseq="XYZ" /> -->

    <asset>
        <mesh name="linear_slider" file="../assets/linear_slider.stl" />
        <mesh name="support_leg" file="../assets/support_leg.stl" />
        <mesh name="support_roof_middle" file="../assets/support_roof_middle.stl" />
        <mesh name="support_roof" file="../assets/support_roof.stl" />
        <mesh name="lift_support" file="../assets/lift_support.stl" />
        <mesh name="lift" file="../assets/lift.stl" />
        <mesh name="ceiling_support" file="../assets/ceiling_support.stl" />
        <mesh name="support_robot" file="../assets/support_robot.stl" />

        <material name="slider_mat" rgba="0.231 0.380 1 1" specular="0.1" shininess="0.5" />
        <material name="support_leg_mat" rgba="0.101 0.101 0.101 1" specular="0.4" shininess="0.4" />
        <material name="support_robot_mat" rgba="0.980 0.713 0.003 1" specular="0.4" shininess="0.4" />

        <model name="robot_layout" file="./robot_layout.xml" />
        <model name="lift_mechanism" file="./mechanisms/lift.xml" />
        <model name="plate_mechanism" file="./mechanisms/plate.xml" />
        <model name="slider_mechanism" file="./mechanisms/slider.xml" />
        <model name="robot_mechanism" file="./mechanisms/robot_lift.xml" />
    </asset>

    <default>
        <default class="slider">
            <geom type="mesh" material="slider_mat" />
        </default>
        <default class="support_color">
            <geom type="mesh" material="support_leg_mat" />
            <default class="support_leg_color">
                <geom type="mesh" mesh="support_leg" />
            </default>
            <default class="support_roof_color">
                <geom type="mesh" contype="0" conaffinity="0" />
            </default>
        </default>
        <default class="robot_support">
            <geom type="mesh" material="support_robot_mat" mesh="support_robot" />
        </default>
        <default class="lift">
            <geom type="mesh" material="support_robot_mat" />
        </default>
    </default>

    <worldbody>
        <frame name="layout_frame" pos="-1.5 2 0">
            <body name="roof_support">
                <geom childclass="support_color" class="support_roof_color" mesh="ceiling_support" />
            </body>

            <body name="slider_bottom">
                <attach model="slider_mechanism" body="slider" prefix="bottom" />

                <!-- <body name="support_sld_btm_1" pos="0 0 0">
                    <geom childclass="support_color" class="support_leg_color" />
                </body>

                <body name="support_sld_btm_2" pos="0 -1.486 0">
                    <geom childclass="support_color" class="support_leg_color" />
                </body>

                <body name="support_sld_btm_3" pos="1.648 0 0">
                    <geom childclass="support_color" class="support_leg_color" />
                </body>

                <body name="support_sld_btm_4" pos="3.296 0 0">
                    <geom childclass="support_color" class="support_leg_color" />
                </body> -->
            </body>

            <frame name="robot_mounts">
                <attach model="robot_layout" prefix="" />
            </frame>

            <body name="slider_top" pos="0 0 1.5">
                <attach model="slider_mechanism" body="slider" prefix="top" />

                <body name="support_sld_1" pos="0 0 -1.5">
                    <geom childclass="support_color" class="support_roof_color"
                        mesh="support_roof_middle" />
                </body>

                <body name="support_sld_2" pos="0 -0.28 -1.5">
                    <geom childclass="support_color" class="support_roof_color"
                        mesh="support_roof" />
                </body>

                <body name="support_sld_3" pos="3.5 0 -1.5" euler="0 0 -1.5708">
                    <geom childclass="support_color" class="support_roof_color"
                        mesh="support_roof" />
                </body>

                <body name="support_sld_4" pos="5 0 -1.5" euler="0 0 -1.5708">
                    <geom childclass="support_color" class="support_roof_color"
                        mesh="support_roof" />
                </body>
            </body>

            <frame name="left_lift_frame" pos="0 0 0">
                <attach model="lift_mechanism" body="lift_support" prefix="left_" />
            </frame>

            <frame name="right_lift_frame" pos="2 -0.304 0" euler="0 0 1.5708">
                <attach model="lift_mechanism" body="lift_support" prefix="right_" />
            </frame>

            <frame name="plate_1_frame" pos="0 0 0">
                <attach model="plate_mechanism" body="plate" prefix="p1_" />
            </frame>

            <frame name="plate_2_frame" pos="0 0 0">
                <attach model="plate_mechanism" body="plate" prefix="p2_" />
            </frame>

            <frame name="plate_3_frame" pos="0 0 0">
                <attach model="plate_mechanism" body="plate" prefix="p3_" />
            </frame>

            <frame name="plate_4_frame" pos="0 0 0">
                <attach model="plate_mechanism" body="plate" prefix="p4_" />
            </frame>

            <frame name="plate_5_frame" pos="0 0 0">
                <attach model="plate_mechanism" body="plate" prefix="p5_" />
            </frame>

            <frame name="plate_6_frame" pos="0 0 0">
                <attach model="plate_mechanism" body="plate" prefix="p6_" />
            </frame>

            <frame name="plate_7_frame" pos="0 0 0">
                <attach model="plate_mechanism" body="plate" prefix="p7_" />
            </frame>

            <frame name="plate_8_frame" pos="0 0 0">
                <attach model="plate_mechanism" body="plate" prefix="p8_" />
            </frame>

            <frame name="plate_9_frame" pos="0 0 0">
                <attach model="plate_mechanism" body="plate" prefix="p9_" />
            </frame>

            <frame name="plate_10_frame" pos="0 0 0">
                <attach model="plate_mechanism" body="plate" prefix="p10_" />
            </frame>

            <frame name="plate_11_frame" pos="0 0 0">
                <attach model="plate_mechanism" body="plate" prefix="p11_" />
            </frame>

        </frame>
    </worldbody>

</mujoco>