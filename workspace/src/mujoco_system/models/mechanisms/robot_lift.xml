<mujoco model="lift">
    <compiler angle="radian" eulerseq="XYZ" />

    <asset>
        <mesh name="robot_lift" file="../../assets/robot_lift/robot_linear_lift.stl" />
        <mesh name="robot_base" file="../../assets/robot_lift/robot_linear_base.stl" />
    </asset>


    <worldbody>
        <body name="robot_lift_base_body" pos="0 0 0">
            <geom name="robot_base" type="mesh" mesh="lift_support" contype="1"
                conaffinity="1" group="1" />

            <body name="robot_lift_carriage" pos="0 0 0" gravcomp="1">
                <joint name="lift_slide" type="slide" pos="0 0 0" axis="0 0 1" range="-0.005 1.505"
                    limited="true" damping="100" />

                <geom name="robot_lift" type="mesh" mesh="plate_p1" contype="1" conaffinity="1"
                    group="1" />
            </body>
        </body>
    </worldbody>

    <actuator>
        <position name="lift_slide" joint="lift_slide" kp="5000" kv="100" ctrllimited="true"
            ctrlrange="-0.005 1.505" forcerange="-300 300" />
    </actuator>

    <contact>
        <exclude body1="robot_lift_carriage" body2="robot_lift_base_body" />
    </contact>
</mujoco>