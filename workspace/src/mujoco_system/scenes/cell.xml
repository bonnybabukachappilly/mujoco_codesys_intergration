<mujoco model="cell">
  <compiler angle="radian" eulerseq="XYZ" />

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" />


  <visual>
    <global azimuth="55" elevation="-25" />
    <headlight ambient="0.45 0.45 0.48" diffuse="0.50 0.50 0.52" specular="0.10 0.10 0.10" />
    <rgba haze="0.75 0.78 0.82 1" />
  </visual>

  <include file="asset.xml" />
  <include file="../models/layout.xml" />


  <worldbody>

    <light pos="0 0 3.8" dir="0 0 -1" diffuse="0.55 0.55 0.58" specular="0.12 0.12 0.12"
      castshadow="true" />
    <light pos="-3 3 3.8" dir="0 0 -1" diffuse="0.45 0.45 0.48" specular="0.10 0.10 0.10"
      castshadow="false" />
    <light pos="3 -3 3.8" dir="0 0 -1" diffuse="0.45 0.45 0.48" specular="0.10 0.10 0.10"
      castshadow="false" />

    <geom name="bay_light_1" type="cylinder" size="0.3 0.04" pos="-2.5 -2.5 3.92"
      material="conduit_silver" />
    <geom name="bay_light_2" type="cylinder" size="0.3 0.04" pos="2.5 -2.5 3.92"
      material="conduit_silver" />
    <geom name="bay_light_3" type="cylinder" size="0.3 0.04" pos="-2.5 2.5 3.92"
      material="conduit_silver" />
    <geom name="bay_light_4" type="cylinder" size="0.3 0.04" pos="2.5 2.5 3.92"
      material="conduit_silver" />

    <!-- Epoxy Floor & Ceiling at 4000mm -->
    <geom name="factory_floor" type="plane" size="15 15 0.1" material="epoxy_floor" />

    <!-- Overhead Structural Steel Rails (Z=3.94m) for Ceiling-Mounted Robot -->
    <!-- <geom name="rail_main_C" type="box" size="0.25 5 0.06" pos="0 0 3.94" material="rail_blue"
    />
    <geom name="rail_main_L" type="box" size="0.15 5 0.06" pos="-2.5 0 3.94"
      material="rail_blue" />
    <geom name="rail_main_R" type="box" size="0.15 5 0.06" pos="2.5 0 3.94" material="rail_blue" />
    <geom name="rail_cross_N" type="box" size="4 0.15 0.06" pos="0 3.5 3.94"
      material="rail_blue" />
    <geom name="rail_cross_S" type="box" size="4 0.15 0.06" pos="0 -3.5 3.94"
      material="rail_blue" /> -->

    <!-- Overhead Cable Trays & Pneumatic Supply Lines -->
    <geom name="cable_tray" type="box" size="0.1 5 0.02" pos="0.4 0 3.86"
      material="conduit_silver" />
    <geom name="air_line_pipe" type="cylinder" size="0.025 5" pos="-0.4 0 3.86"
      quat="0.7071 0.7071 0 0" material="conduit_silver" />

    <!-- Cell Boundaries & Green Pedestrian Walkway -->
    <geom name="cell_line_N" type="box" size="4.05 0.05 0.001" pos="0 5 0.001"
      material="safety_yellow" />
    <geom name="cell_line_S" type="box" size="4.05 0.05 0.001" pos="0 -5 0.001"
      material="safety_yellow" />
    <geom name="cell_line_E" type="box" size="0.05 5.05 0.001" pos="4 0 0.001"
      material="safety_yellow" />
    <geom name="cell_line_W" type="box" size="0.05 5.05 0.001" pos="-4 0 0.001"
      material="safety_yellow" />
    <geom name="pedestrian_walkway" type="box" size="6 0.6 0.001" pos="0 -6.2 0.001"
      material="walkway_green" />

    <!-- Perimeter Safety Fencing -->
    <geom name="fence_W_frame" type="box" size="0.04 5 0.04" pos="-4 0 1" material="fence_frame" />
    <geom name="fence_W_glass" type="box" size="0.01 4.9 0.9" pos="-4 0 1" material="fence_mesh" />
    <geom name="fence_E_frame" type="box" size="0.04 5 0.04" pos="4 0 1" material="fence_frame" />
    <geom name="fence_E_glass" type="box" size="0.01 4.9 0.9" pos="4 0 1" material="fence_mesh" />
    <geom name="fence_N_frame" type="box" size="4 0.04 0.04" pos="0 5 1" material="fence_frame" />
    <geom name="fence_N_glass" type="box" size="3.9 0.01 0.9" pos="0 5 1" material="fence_mesh" />
    <geom name="fence_S_L" type="box" size="1.25 0.01 0.9" pos="-2.75 -5 1"
      material="fence_mesh" />
    <geom name="fence_S_R" type="box" size="1.25 0.01 0.9" pos="2.75 -5 1" material="fence_mesh" />

    <!-- Safety Light Curtains (Optical Safety Barriers at Cell Entrance) -->
    <geom name="curtain_pole_L" type="cylinder" size="0.04 0.9" pos="-1.45 -5 0.9"
      material="safety_yellow" />
    <geom name="curtain_pole_R" type="cylinder" size="0.04 0.9" pos="1.45 -5 0.9"
      material="safety_yellow" />
    <geom name="curtain_sensor_L" type="box" size="0.02 0.02 0.8" pos="-1.45 -4.95 0.9"
      material="dark_metal" />
    <geom name="curtain_sensor_R" type="box" size="0.02 0.02 0.8" pos="1.45 -4.95 0.9"
      material="dark_metal" />

    <!-- Main Electrical Control Cabinet with Display -->
    <body name="main_control_cabinet" pos="3.5 4.3 0">
      <geom type="box" size="0.4 0.3 1" pos="0 0 1" material="cabinet_orange" />
      <geom type="box" size="0.02 0.25 0.2" pos="-0.41 0 1.4" material="dark_metal" />
      <geom type="cylinder" size="0.02 0.08" pos="-0.41 0.15 1.1" material="dark_metal" />
    </body>

    <!-- Industrial Stack Light / 3-Stage Signal Tower -->
    <body name="signal_tower" pos="3.5 4.3 2">
      <geom type="cylinder" size="0.02 0.2" pos="0 0 0.2" material="dark_metal" />
      <geom type="cylinder" size="0.04 0.05" pos="0 0 0.45" material="status_green" />
      <geom type="cylinder" size="0.04 0.05" pos="0 0 0.56" material="status_yellow" />
      <geom type="cylinder" size="0.04 0.05" pos="0 0 0.67" material="status_red" />
    </body>

    <!-- Operator Emergency Stop Station -->
    <body name="operator_pedestal" pos="-1.8 -5.3 0">
      <geom type="cylinder" size="0.05 0.5" pos="0 0 0.5" material="dark_metal" />
      <geom type="box" size="0.15 0.15 0.1" pos="0 0 1.05" material="safety_yellow" />
      <geom type="cylinder" size="0.03 0.02" pos="0 0 1.16" material="estop_red" />
    </body>

    <!-- Mobile Tool Cart / Maintenance Station -->
    <body name="tool_cart" pos="-4.8 -2.5 0">
      <geom type="box" size="0.35 0.6 0.4" pos="0 0 0.45" material="tool_red" />
      <geom type="box" size="0.37 0.62 0.02" pos="0 0 0.86" material="dark_metal" />
      <geom type="cylinder" size="0.03 0.04" pos="-0.3 0.5 0.04" material="dark_metal" />
      <geom type="cylinder" size="0.03 0.04" pos="0.3 0.5 0.04" material="dark_metal" />
      <geom type="cylinder" size="0.03 0.04" pos="-0.3 -0.5 0.04" material="dark_metal" />
      <geom type="cylinder" size="0.03 0.04" pos="0.3 -0.5 0.04" material="dark_metal" />
    </body>

    <!-- Fire Safety Station -->
    <body name="fire_station" pos="-3.95 4.5 0">
      <geom type="cylinder" size="0.08 0.25" pos="0 0 0.8" material="estop_red" />
      <geom type="cylinder" size="0.02 0.06" pos="0 0 1.1" material="dark_metal" />
    </body>

    <!-- <frame name="layout_mount" pos="-1.5 2 0">
      <attach model="cell_layout" prefix="layout" />
    </frame> -->
  </worldbody>

  <keyframe>
    <key name="home"
      qpos="0 -1.57 1.57 0 0 0 0 -1.57 1.57 0 0 0 0 -1.57 1.57 0 0 0 0 -1.57 1.57 0 0 0 0 -1.57 1.57 0 0 0 0 -1.57 1.57 0 0 0"
      ctrl="0 -1.57 1.57 0 0 0 0 -1.57 1.57 0 0 0 0 -1.57 1.57 0 0 0 0 -1.57 1.57 0 0 0 0 -1.57 1.57 0 0 0 0 -1.57 1.57 0 0 0" />
  </keyframe>

</mujoco>