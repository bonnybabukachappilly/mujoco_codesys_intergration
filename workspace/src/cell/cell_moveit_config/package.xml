<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cell_moveit_config</name>
  <version>0.1.0</version>
  <description>MoveIt 2 configuration of the cell: SRDF, kinematics, joint limits, OMPL and controller mapping.</description>
  <maintainer email="bonnybabukachappilly@gmail.com">bonnybk</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>cell_description</build_depend>
  <build_depend>python3-yaml</build_depend>
  <exec_depend>cell_description</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
