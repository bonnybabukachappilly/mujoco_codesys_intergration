<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="mech_joint_interface"
        params="joint_name limit:=0 command:=true command_type:='effort' min_val:='' max_val:='' init:=0.0">
        <joint name="${joint_name}">
            <xacro:if value="${command}">
                <command_interface name="${command_type}">
                    <xacro:if value="${command_type == 'effort'}">
                        <param name="min">-${limit}</param>
                        <param name="max">${limit}</param>
                    </xacro:if>
                    <xacro:if value="${command_type == 'position'}">
                        <param name="min">${min_val}</param>
                        <param name="max">${max_val}</param>
                    </xacro:if>
                </command_interface>
            </xacro:if>
            <state_interface name="position">
                <param name="initial_value">${init}</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
    </xacro:macro>

    <xacro:macro name="station_mechanism_joints">
        <xacro:mech_joint_interface joint_name="left_lift_slide" command_type="position"
            min_val="-0.005" max_val="1.505" init="-0.005" />
        <xacro:mech_joint_interface joint_name="right_lift_slide" command_type="position"
            min_val="-0.005" max_val="1.505" init="-0.005" />

        <xacro:mech_joint_interface joint_name="p1_plate_x" command_type="position" min_val="-0.01"
            max_val="4.0" init="0.0" />
        <xacro:mech_joint_interface joint_name="p1_plate_y" command_type="position" min_val="-2.05"
            max_val="0.01" init="-1.0" />
        <xacro:mech_joint_interface joint_name="p1_plate_z" command="false" init="0.0" />


        <xacro:mech_joint_interface joint_name="p2_plate_x" command_type="position" min_val="-0.01"
            max_val="4.0" init="0.0" />
        <xacro:mech_joint_interface joint_name="p2_plate_y" command_type="position" min_val="-2.05"
            max_val="0.01" init="0.0" />
        <xacro:mech_joint_interface joint_name="p2_plate_z" command="false" init="0.0" />


        <xacro:mech_joint_interface joint_name="p3_plate_x" command_type="position" min_val="-0.01"
            max_val="4.0" init="1.0" />
        <xacro:mech_joint_interface joint_name="p3_plate_y" command_type="position" min_val="-2.05"
            max_val="0.01" init="0.0" />
        <xacro:mech_joint_interface joint_name="p3_plate_z" command="false" init="0.0" />


        <xacro:mech_joint_interface joint_name="p4_plate_x" command_type="position" min_val="-0.01"
            max_val="4.0" init="2.0" />
        <xacro:mech_joint_interface joint_name="p4_plate_y" command_type="position" min_val="-2.05"
            max_val="0.01" init="0.0" />
        <xacro:mech_joint_interface joint_name="p4_plate_z" command="false" init="0.0" />


        <xacro:mech_joint_interface joint_name="p5_plate_x" command_type="position" min_val="-0.01"
            max_val="4.0" init="3.0" />
        <xacro:mech_joint_interface joint_name="p5_plate_y" command_type="position" min_val="-2.05"
            max_val="0.01" init="0.0" />
        <xacro:mech_joint_interface joint_name="p5_plate_z" command="false" init="0.0" />


        <xacro:mech_joint_interface joint_name="p6_plate_x" command_type="position" min_val="-0.01"
            max_val="4.0" init="3.0" />
        <xacro:mech_joint_interface joint_name="p6_plate_y" command_type="position" min_val="-2.05"
            max_val="0.01" init="0.0" />
        <xacro:mech_joint_interface joint_name="p6_plate_z" command="false" init="1.5" />


        <xacro:mech_joint_interface joint_name="p7_plate_x" command_type="position" min_val="-0.01"
            max_val="4.0" init="2.0" />
        <xacro:mech_joint_interface joint_name="p7_plate_y" command_type="position" min_val="-2.05"
            max_val="0.01" init="0.0" />
        <xacro:mech_joint_interface joint_name="p7_plate_z" command="false" init="1.5" />


        <xacro:mech_joint_interface joint_name="p8_plate_x" command_type="position" min_val="-0.01"
            max_val="4.0" init="1.0" />
        <xacro:mech_joint_interface joint_name="p8_plate_y" command_type="position" min_val="-2.05"
            max_val="0.01" init="0.0" />
        <xacro:mech_joint_interface joint_name="p8_plate_z" command="false" init="1.5" />


        <xacro:mech_joint_interface joint_name="p9_plate_x" command_type="position" min_val="-0.01"
            max_val="4.0" init="0.0" />
        <xacro:mech_joint_interface joint_name="p9_plate_y" command_type="position" min_val="-2.05"
            max_val="0.01" init="0.0" />
        <xacro:mech_joint_interface joint_name="p9_plate_z" command="false" init="1.5" />


        <xacro:mech_joint_interface joint_name="p10_plate_x" command_type="position" min_val="-0.01"
            max_val="4.0" init="0.0" />
        <xacro:mech_joint_interface joint_name="p10_plate_y" command_type="position" min_val="-2.05"
            max_val="0.01" init="-1.0" />
        <xacro:mech_joint_interface joint_name="p10_plate_z" command="false" init="1.5" />


        <xacro:mech_joint_interface joint_name="p11_plate_x" command_type="position" min_val="-0.01"
            max_val="4.0" init="0.0" />
        <xacro:mech_joint_interface joint_name="p11_plate_y" command_type="position" min_val="-2.05"
            max_val="0.01" init="-2.0" />
        <xacro:mech_joint_interface joint_name="p11_plate_z" command="false" init="0.0" />

    </xacro:macro>
</robot>