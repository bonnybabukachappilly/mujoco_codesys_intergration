<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cr5">

    <xacro:arg name="prefix" default="" />
    <xacro:arg name="mujoco_model" default="$(find dobot_mujoco_integration)/scenes/main_scene.xml" />

    <xacro:include filename="$(find dobot_description)/urdf/cr5/cr5_macro.xacro" />
    <xacro:include filename="$(find dobot_description)/urdf/cr5/cr5_controller.xacro" />

    <link name="world" />

    <joint name="$(arg prefix)world_to_base_joint" type="fixed">
        <parent link="world" />
        <child link="$(arg prefix)base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <xacro:cr5_robot prefix="$(arg prefix)" />

    <xacro:cr5_ros2_control prefix="$(arg prefix)" mujoco_model="$(arg mujoco_model)" />

</robot>